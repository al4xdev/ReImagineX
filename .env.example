# ComfyUI backend URL
COMFY_URL=http://127.0.0.1:8001

# Data directory for images and state
DATA_DIR=gallery_data

# Network binding (0.0.0.0 exposes the gallery on your local network / Wi-Fi)
# REIMAGINEX_HOST=0.0.0.0
# REIMAGINEX_PORT=8888

# LLM API keys (DeepSeek is the default provider, OpenRouter is the fallback)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ComfyUI Model Names (optional overrides)
# DIFFUSION_MODEL_NAME=qwen_image_2.1_int8_convrot.safetensors
# CLIP_MODEL_NAME=qwen3vl_8b_int8_convrot.safetensors
# VAE_MODEL_NAME=qwen_image_2.1_vae_bf16.safetensors

# NOTE: values saved from the Settings Panel are written to DATA_DIR/config.json
# and take precedence over this file once it exists.
